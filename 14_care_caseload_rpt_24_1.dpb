<component name = 'JAVASCRIPT'><property name = 'CODE:00'><![CDATA[var theForm = null;

function onLoad() {
    
    theForm = new DiscernForm();
    theForm.SEARCH_BUTTON_PRSNL.onClick = onSearchButtonClick;
    theForm.PRSNL_LIST.deleteRecord(1);//REMOVE THE ZERO ROW FROM VIEW
    theForm.PRSNL_LIST.updateFields();
    theForm.reformat();
    theForm.updateUI();
    // insert event handlers

}



function onSearchButtonClick(sender) {
    var providerLastName = theForm.PRSNL_SEARCH.value;            
    var queryString  =  "SELECT PRSNL_ID = PR.PERSON_ID,PRSNL_FULL_NAME = TRIM(PR.NAME_FULL_FORMATTED,3)";
        queryString += " FROM PRSNL PR";
        queryString += " PLAN PR WHERE CNVTUPPER(PR.NAME_LAST) = VALUE(CONCAT('"+providerLastName+"','*'))";
        queryString += " AND PR.BEG_EFFECTIVE_DT_TM <= CNVTDATETIME(CURDATE,CURTIME3)";
        queryString += " AND PR.END_EFFECTIVE_DT_TM > CNVTDATETIME(CURDATE,CURTIME3)";
        queryString += " AND PR.ACTIVE_IND = 1";        
        queryString += " ORDER BY PRSNL_FULL_N]]></property>
<property name = 'CODE:01'><![CDATA[AME, PR.PERSON_ID"; 
    theForm.PRSNL_LIST.query=queryString;                        
//  theForm.USERID.selectAll(0);//DESELECT THE PREVIOUS SELECTION
    theForm.PRSNL_LIST.updateFields();
    theForm.reformat();
    theForm.updateUI();
}                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 ]]></property>
</component>
</control>
</prompt-def>
