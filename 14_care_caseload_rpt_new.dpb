<property name = 'SETTINGS:00'><![CDATA[DEFAULT-KEY='*' QUERY-STRING='SELECT DISTINCT 
PRSNL_ID &#061; PR.PERSON_ID,
PRSNL_FULL_NAME &#061; TRIM(PR.NAME_FULL_FORMATTED,3) 
FROM PRSNL PR
PLAN PR WHERE PR.PERSON_ID &#061; 0.0


